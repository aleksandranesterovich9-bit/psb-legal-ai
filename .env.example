# Скопируйте в .env и подставьте адрес и ключи, выданные организаторами.
# Без ключей приложение работает в режиме поиска: показывает найденные положения без генерации.

# Базовый адрес OpenAI-совместимого API (запасные имена: BASE_URL, OPENAI_BASE_URL).
# На платформе его задают организаторы. Для своей проверки подойдёт OpenRouter:
# там есть deepseek/deepseek-v4.1-flash и baai/bge-m3 под теми же именами.
#   LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=
# Ключ генеративной модели (запасное имя: OPENAI_API_KEY)
LLM_API_KEY=
# Ключи эмбеддера и реранкера; если пусто — используется LLM_API_KEY
EMBEDDER_API_KEY=
RERANKER_API_KEY=

# Модели из технического регламента хакатона
LLM_MODEL=deepseek/deepseek-v4.1-flash
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=qwen/qwen3-reranker-8b

# Необязательные настройки
TEMPERATURE=0
MAX_TOKENS=6000
MAX_WORKERS=4
LLM_TIMEOUT=90
LLM_RETRIES=3
# DISABLE_EMBEDDINGS=1
# DISABLE_RERANKER=1
APP_PORT=8000
# Усилие рассуждения DeepSeek (low|medium|high), если провайдер поддерживает параметр reasoning
# LLM_REASONING_EFFORT=low
